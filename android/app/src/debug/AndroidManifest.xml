<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug-only: allow cleartext to localhost / the emulator host so the
         local-dev relay (http://localhost:8787 via adb reverse) works on a modern
         targetSdk. Merges its networkSecurityConfig onto the main <application>;
         release builds don't include it and stay HTTPS-only. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
